{
  "name": "i-didnt-write-this",
  "version": "0.1.1",
  "description": "Turn one feature of a JavaScript or TypeScript project into an interactive, evidence-backed lesson.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gjusev/i-didnt-write-this.git"
  },
  "bugs": {
    "url": "https://github.com/Gjusev/i-didnt-write-this/issues"
  },
  "homepage": "https://github.com/Gjusev/i-didnt-write-this#readme",
  "keywords": [
    "claude",
    "agent-skills",
    "skill",
    "code-comprehension",
    "learning-by-doing",
    "interactive-lesson",
    "javascript",
    "typescript"
  ],
  "bin": {
    "idwt": "skills/i-didnt-write-this/assets/toolkit.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "skills",
    "fixtures"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" \"fixtures/*/test/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0"
  }
}
