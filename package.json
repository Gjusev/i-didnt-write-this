{
  "name": "i-didnt-write-this",
  "version": "0.1.0",
  "private": true,
  "description": "Turn one feature of a JavaScript or TypeScript project into an interactive, evidence-backed lesson.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\" \"fixtures/*/test/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "demo": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0"
  }
}
